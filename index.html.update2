        </audio>



    <figure>
          <img 
    src="image/mountain-sunrise.jpg" alt="sunrise behind a snow-covered mountain with pink sunset colors" 
    width="600" height="400">
     <figcaption> sunrise over the snoow-covered mountain</figcaption>
    </figure>
           <img src="image/decorative-divider.png" alt"" width="600" height=""100">

    </main>

